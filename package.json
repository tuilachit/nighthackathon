{
  "name": "fitment",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=24.3 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "catalog:validate": "vitest run lib/catalog-validation.test.ts",
    "catalog:sync": "tsx --env-file-if-exists=.env.local scripts/catalog/sync-catalog.ts",
    "assets:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/catalog/generate-model-assets.ts",
    "assets:generate-all": "tsx --env-file-if-exists=.env.local scripts/catalog/generate-all-models.ts",
    "assets:usdz": "tsx scripts/catalog/generate-usdz-heroes.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@google/model-viewer": "^4.2.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.5.0",
    "next": "^15.5.22",
    "postcss": "^8.5.23",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1",
    "sharp": "^0.35.3",
    "three": "^0.182.0",
    "tldts": "7.4.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.39",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "@types/webxr": "^0.5.24",
    "cheerio": "1.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "jsdom": "^24.1.3",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "$postcss",
    "sharp": "^0.35.3"
  }
}
